{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QM: Full Stack (No Slack)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev-instance:no-slack -- --force",
      "cwd": "${workspaceFolder}/qm"
    },
    {
      "name": "QM: Dev Status",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev-instance:status",
      "cwd": "${workspaceFolder}/qm"
    },
    {
      "name": "QM: Dev Doctor",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev-instance:doctor",
      "cwd": "${workspaceFolder}/qm"
    },
    {
      "name": "Backend: QM + Knowlega Agent (standalone)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/qm-backend",
      "args": [
        "--config",
        "${workspaceFolder}/configs/qm-config.yaml"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Tests: QM + Knowlega (Go)",
      "type": "node-terminal",
      "request": "launch",
      "command": "env GOCACHE=/private/tmp/knowlega-gocache go test ./...",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Tests: Go package (debug current)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": [
        "-test.v"
      ],
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": []
}
