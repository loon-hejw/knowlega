{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: QM + Knowlega Agent",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/qm-backend",
      "args": [
        "--config",
        "${workspaceFolder}/qm-backend/configs/config.yaml"
      ],
      "cwd": "${workspaceFolder}"
    }
    {
      "name": "Tests: QM + Knowlega (Go)",
      "type": "node-terminal",
      "request": "launch",
      "command": "env GOCACHE=/private/tmp/knowlega-gocache go test ./...",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Tests: Go package (debug current)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": [
        "-test.v"
      ],
      "cwd": "${workspaceFolder}"
    },
  ],
  "compounds": []
}
