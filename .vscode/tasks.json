{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "qm: start full stack (no Slack)",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "dev-instance:no-slack",
        "--",
        "--force"
      ],
      "options": {
        "cwd": "${workspaceFolder}/qm"
      },
      "problemMatcher": []
    },
    {
      "label": "qm: dev status",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "dev-instance:status"
      ],
      "options": {
        "cwd": "${workspaceFolder}/qm"
      },
      "problemMatcher": []
    },
    {
      "label": "qm: dev doctor",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "dev-instance:doctor"
      ],
      "options": {
        "cwd": "${workspaceFolder}/qm"
      },
      "problemMatcher": []
    },
    {
      "label": "qm: stop full stack",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "dev-instance:down"
      ],
      "options": {
        "cwd": "${workspaceFolder}/qm"
      },
      "problemMatcher": []
    }
  ]
}
