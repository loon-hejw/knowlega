{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go 后端",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/qm-backend",
      "args": [
        "--config",
        "${workspaceFolder}/config.yaml"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "GOCACHE": "/private/tmp/knowlega-gocache",
        "DATABASE_URL": "",
        "ORG_ID": "",
        "NODE_CORE_URL": "",
        "CORE_SIGNING_SECRET": "",
        "CAPABILITY_SECRET": "",
        "PORTAL_IDENTITY_SECRET": "",
        "QM_ROUTE_MODE": "",
        "PORT": "",
        "MAX_CLAIMS": "",
        "SOURCE_AUTH_REPLAY_WINDOW_SECONDS": ""
      },
      "preLaunchTask": "ide: shared PostgreSQL",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "前端",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/plugins/web-ui",
      "console": "integratedTerminal",
      "env": {
        "PORT": "18129",
        "PORTAL_PUBLIC_URL": "http://localhost:18129",
        "WEB_UI_PUBLIC_URL": "http://localhost:18129",
        "CORE_API_URL": "http://127.0.0.1:19829",
        "CORE_ORG_ID": "local",
        "WEB_UI_BASE": "/",
        "WEB_UI_PRINCIPALS": "",
        "ADMIN_BASE_PATH": "/admin",
        "NODE_ENV": "development",
        "PORTAL_LOCAL_AUTH_BYPASS": "1",
        "PORTAL_DEV_PRINCIPAL": "hejw",
        "ANTHROPIC_API_KEY": null,
        "ANTHROPIC_BASE_URL": null,
        "OPENAI_API_KEY": null,
        "OPENAI_BASE_URL": null,
        "OPENROUTER_API_KEY": null,
        "OPENROUTER_BASE_URL": null,
        "SLACK_BOT_TOKEN": null,
        "SLACK_APP_TOKEN": null,
        "PATH": "${env:HOME}/.nvm/versions/node/v24.13.0/bin:${env:PATH}"
      },
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v24.13.0/bin/npm",
      "envFile": "${workspaceFolder}/config.local/ide-frontend.env",
      "internalConsoleOptions": "neverOpen",
      "runtimeArgs": [
        "start"
      ],
      "autoAttachChildProcesses": true
    }
  ]
}
