{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: kbcore serve (LLM)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/kbcore",
      "args": [
        "--config",
        "${workspaceFolder}/config.yaml",
        "serve"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Tests: Knowledge Core (Go)",
      "type": "node-terminal",
      "request": "launch",
      "command": "env GOCACHE=/private/tmp/kbcore-gocache go test ./...",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Tests: Go package (debug current)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": [
        "-test.v"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Tests: QM Web UI",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm test",
      "cwd": "${workspaceFolder}/qm/plugins/web-ui"
    }
  ],
  "compounds": [
    {
      "name": "Tests: Knowledge Core + QM Web UI",
      "configurations": [
        "Tests: Knowledge Core (Go)",
        "Tests: QM Web UI"
      ],
      "stopAll": false
    }
  ]
}
